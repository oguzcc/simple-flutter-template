# Staging Environment Configuration
APP_NAME=Daisy Staging
API_BASE_URL=https://staging-api.example.com
ENVIRONMENT=staging

# Firebase Configuration
FIREBASE_PROJECT_ID=your-staging-firebase-project-id
FIREBASE_API_KEY=your-staging-firebase-api-key
FIREBASE_APP_ID=your-staging-firebase-app-id

# Sentry Configuration (Optional)
SENTRY_DSN=your-staging-sentry-dsn

# API Keys (Optional)
GOOGLE_API_KEY=your-staging-google-api-key
APPLE_API_KEY=your-staging-apple-api-key

# Analytics Configuration
SMARTLOOK_API_KEY=your-staging-smartlook-api-key
MIXPANEL_PROJECT_TOKEN=your-staging-mixpanel-token

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=false
ENABLE_PUSH_NOTIFICATIONS=true

# Debug Settings
DEBUG_NETWORK_LOGGER=false
DEBUG_CONSOLE_LOGGING=false