# Development Environment Configuration
APP_NAME=Daisy Dev
API_BASE_URL=https://dev-api.example.com
ENVIRONMENT=development

# Firebase Configuration
FIREBASE_PROJECT_ID=your-dev-firebase-project-id
FIREBASE_API_KEY=your-dev-firebase-api-key
FIREBASE_APP_ID=your-dev-firebase-app-id

# Sentry Configuration (Optional)
SENTRY_DSN=your-dev-sentry-dsn

# API Keys (Optional)
GOOGLE_API_KEY=your-dev-google-api-key
APPLE_API_KEY=your-dev-apple-api-key

# Analytics Configuration
SMARTLOOK_API_KEY=your-dev-smartlook-api-key
MIXPANEL_PROJECT_TOKEN=your-dev-mixpanel-token

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_PUSH_NOTIFICATIONS=true

# Debug Settings
DEBUG_NETWORK_LOGGER=true
DEBUG_CONSOLE_LOGGING=true