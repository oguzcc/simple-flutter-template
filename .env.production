# Production Environment Configuration
APP_NAME=Daisy
API_BASE_URL=https://api.example.com
ENVIRONMENT=production

# Firebase Configuration
FIREBASE_PROJECT_ID=your-prod-firebase-project-id
FIREBASE_API_KEY=your-prod-firebase-api-key
FIREBASE_APP_ID=your-prod-firebase-app-id

# Sentry Configuration (Optional)
SENTRY_DSN=your-prod-sentry-dsn

# API Keys (Optional)
GOOGLE_API_KEY=your-prod-google-api-key
APPLE_API_KEY=your-prod-apple-api-key

# Analytics Configuration
SMARTLOOK_API_KEY=your-prod-smartlook-api-key
MIXPANEL_PROJECT_TOKEN=your-prod-mixpanel-token

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_PUSH_NOTIFICATIONS=true

# Debug Settings
DEBUG_NETWORK_LOGGER=false
DEBUG_CONSOLE_LOGGING=false